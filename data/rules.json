  "conventions": {
    "pinyin": "例词拼音：空格 = 分写（空方）；音节相连 = 连写；一律小写；写本调；轻声不标调；音节后加 ! 表示声调不省写（10.2.8）。",
    "initialsNote": "k 与 q、h 与 x、g 与 j 点位相同，但省写规则按拼音声母字母判断。",
    "zeroInitial": "“∅”表示零声母（韵母自成音节）。"
  },
  "rules": [
    {
      "id": "9.1",
      "title": "音节拼写顺序",
      "cat": "拼写",
      "page": 6,
      "text": "音节通常由声母、韵母、声调构成，依次拼写。",
      "apply": {
        "type": "syllableOrder",
        "order": [
          "initial",
          "final",
          "tone"
        ]
      },
      "examples": [
        [
          "中",
          "zhōng"
        ],
        [
          "国",
          "guó"
        ],
        [
          "裳",
          "shang"
        ]
      ]
    },
    {
      "id": "9.2",
      "title": "zhi chi shi 等省略 i",
      "cat": "拼写",
      "page": 6,
      "text": "音节 zhi、chi、shi、ri、zi、ci、si 省略韵母 i，声母自成音节。",
      "note": "z、c、s、r 表示字母时加字母号；不产生混淆时字母号可以省略。",
      "apply": {
        "type": "apical",
        "syllables": [
          "zhi",
          "chi",
          "shi",
          "ri",
          "zi",
          "ci",
          "si"
        ],
        "dropFinal": "i"
      },
      "examples": [
        [
          "知",
          "zhī"
        ],
        [
          "蚩",
          "chī"
        ],
        [
          "诗",
          "shī"
        ],
        [
          "日",
          "rì"
        ],
        [
          "资",
          "zī"
        ],
        [
          "雌",
          "cí"
        ],
        [
          "思",
          "sī"
        ]
      ]
    },
    {
      "id": "9.3",
      "title": "韵母自成音节",
      "cat": "拼写",
      "page": 6,
      "text": "韵母可自成音节。",
      "note": "y、w 不写，用完整韵母：yi→i，wan→uan，yue→üe，ya→ia。",
      "apply": {
        "type": "zeroInitial",
        "note": "y、w 不写，用 pinyin_map.json 的 zeroInitial 还原为完整韵母"
      },
      "examples": [
        [
          "爱",
          "ài"
        ],
        [
          "恩",
          "ēn"
        ],
        [
          "仪",
          "yí"
        ],
        [
          "碗",
          "wǎn"
        ],
        [
          "悦",
          "yuè"
        ],
        [
          "呀",
          "ya"
        ],
        [
          "呃",
          "e"
        ]
      ]
    },
    {
      "id": "9.4",
      "title": "他、它的特殊拼写",
      "cat": "拼写",
      "page": 6,
      "text": "“他、它”特殊拼写。",
      "note": "“她”(tā) 按拼写规则写作 t + a + 阴平：(2345)(35)(1)。",
      "apply": {
        "type": "specialForm",
        "chars": [
          "他",
          "它"
        ],
        "useForms": true,
        "note": "不简写时使用（见 11.2）"
      },
      "forms": [
        {
          "word": "他",
          "pinyin": "tā",
          "dots": [
            "2345",
            "35"
          ],
          "desc": "t + a，不标调"
        },
        {
          "word": "它",
          "pinyin": "tā",
          "dots": [
            "4",
            "2345",
            "35"
          ],
          "desc": "(4) + t + a，不标调"
        }
      ]
    },
    {
      "id": "10.1.1",
      "title": "每个音节都标调",
      "cat": "标调",
      "page": 6,
      "text": "每个音节都标调。",
      "apply": {
        "type": "toneEverySyllable",
        "neutralTone": "none"
      },
      "examples": [
        [
          "盲",
          "máng"
        ],
        [
          "曲子",
          "qǔzi"
        ]
      ]
    },
    {
      "id": "10.1.2",
      "title": "变调音节标本调",
      "cat": "标调",
      "page": "6–7",
      "text": "变调音节标本调。",
      "apply": {
        "type": "baseTone",
        "note": "数据中一律写本调，引擎不做变调"
      },
      "examples": [
        [
          "一头",
          "yītóu"
        ],
        [
          "不至于",
          "bùzhìyú"
        ],
        [
          "牡丹",
          "mǔdan"
        ],
        [
          "土腥气",
          "tǔ·xīngqì",
          "含间隔号，暂不支持"
        ],
        [
          "沉甸甸",
          "chéndiàndiàn"
        ]
      ]
    },
    {
      "id": "10.2.1",
      "title": "f 声母省阴平",
      "cat": "省写",
      "page": 7,
      "text": "声母为 f 的音节，省写阴平符号。",
      "apply": {
        "type": "omitTone",
        "tone": 1,
        "initials": [
          "f"
        ]
      },
      "examples": [
        [
          "芬",
          "fēn"
        ],
        [
          "风帆",
          "fēngfān"
        ],
        [
          "非凡",
          "fēifán"
        ],
        [
          "方法",
          "fāngfǎ"
        ],
        [
          "奋发",
          "fènfā"
        ]
      ]
    },
    {
      "id": "10.2.2",
      "title": "九个声母省阳平",
      "cat": "省写",
      "page": 7,
      "text": "声母为 p、m、t、n、h、q、ch、r、c 的音节，省写阳平符号；音节 tóu 的声调符号不省写。",
      "apply": {
        "type": "omitTone",
        "tone": 2,
        "initials": [
          "p",
          "m",
          "t",
          "n",
          "h",
          "q",
          "ch",
          "r",
          "c"
        ],
        "keepSyllables": [
          "tóu"
        ]
      },
      "examples": [
        [
          "词",
          "cí"
        ],
        [
          "和平",
          "hépíng"
        ],
        [
          "人民",
          "rénmín"
        ],
        [
          "非常",
          "fēicháng"
        ],
        [
          "红旗",
          "hóngqí"
        ],
        [
          "成年",
          "chéngnián"
        ],
        [
          "田头",
          "tiántóu"
        ]
      ]
    },
    {
      "id": "10.2.3",
      "title": "十一个声母省去声",
      "cat": "省写",
      "page": "7–8",
      "text": "声母为 b、d、l、g、k、j、x、zh、sh、z、s 的音节，省写去声符号；音节 lè、zì 的声调符号不省写。",
      "apply": {
        "type": "omitTone",
        "tone": 4,
        "initials": [
          "b",
          "d",
          "l",
          "g",
          "k",
          "j",
          "x",
          "zh",
          "sh",
          "z",
          "s"
        ],
        "keepSyllables": [
          "lè",
          "zì"
        ]
      },
      "examples": [
        [
          "坝",
          "bà"
        ],
        [
          "重视",
          "zhòngshì"
        ],
        [
          "干劲",
          "gànjìn"
        ],
        [
          "情况",
          "qíngkuàng"
        ],
        [
          "贺信",
          "hèxìn"
        ],
        [
          "大气层",
          "dàqìcéng"
        ],
        [
          "快乐",
          "kuàilè"
        ],
        [
          "红十字会",
          "hóngshízìhuì"
        ]
      ]
    },
    {
      "id": "10.2.4",
      "title": "韵母自成音节省去声",
      "cat": "省写",
      "page": 8,
      "text": "韵母自成音节，省写去声符号，第 10.2.5 和 10.2.6 条规定的除外。",
      "apply": {
        "type": "omitTone",
        "tone": 4,
        "initials": [
          "∅"
        ],
        "overriddenBy": [
          "10.2.5",
          "10.2.6"
        ]
      },
      "examples": [
        [
          "育",
          "yù"
        ],
        [
          "爱国",
          "àiguó"
        ],
        [
          "运用",
          "yùnyòng"
        ],
        [
          "望远镜",
          "wàngyuǎnjìng"
