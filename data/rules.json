        [
          "物联网",
          "wùliánwǎng"
        ]
      ]
    },
    {
      "id": "10.2.5",
      "title": "一、而、我、也、有的省调",
      "cat": "省写",
      "page": 8,
      "text": "音节 yī、ér、wǒ、yě、yǒu 的声调符号省写；音节 yì、èr、wò、yè、yòu 的声调符号不省写。",
      "apply": {
        "type": "syllableTone",
        "omit": [
          "yī",
          "ér",
          "wǒ",
          "yě",
          "yǒu"
        ],
        "keep": [
          "yì",
          "èr",
          "wò",
          "yè",
          "yòu"
        ]
      },
      "examples": [
        [
          "我",
          "wǒ"
        ],
        [
          "沃",
          "wò"
        ],
        [
          "也许",
          "yěxǔ"
        ],
        [
          "有益",
          "yǒuyì"
        ],
        [
          "而且",
          "érqiě"
        ],
        [
          "二维码",
          "èrwéimǎ"
        ]
      ]
    },
    {
      "id": "10.2.6",
      "title": "o 音节省调",
      "cat": "省写",
      "page": 8,
      "text": "音节 ō、ó、ǒ、ò 的声调符号省写；音节 ē、é、ě、è 的声调符号不省写。",
      "apply": {
        "type": "syllableTone",
        "omit": [
          "ō",
          "ó",
          "ǒ",
          "ò"
        ],
        "keep": [
          "ē",
          "é",
          "ě",
          "è"
        ]
      },
      "examples": [
        [
          "哦",
          "ó"
        ],
        [
          "嚄",
          "ǒ"
        ],
        [
          "扼要",
          "èyào"
        ]
      ]
    },
    {
      "id": "10.2.7",
      "title": "声母自成音节后接韵母音节",
      "cat": "省写",
      "page": 8,
      "text": "声母自成音节后面连写韵母自成音节时，声母自成音节不适用省写规则 10.2.2 和 10.2.3。",
      "apply": {
        "type": "disableRules",
        "when": {
          "this": "apical",
          "nextInWord": "zeroInitial"
        },
        "disable": [
          "10.2.2",
          "10.2.3"
        ]
      },
      "examples": [
        [
          "慈爱",
          "cí'ài"
        ],
        [
          "事业",
          "shìyè"
        ]
      ]
    },
    {
      "id": "10.2.8",
      "title": "需要时不省写",
      "cat": "省写",
      "page": 9,
      "text": "需要声调符号提供点位参照或者区分音义时，声调符号应不省写。",
      "note": "此条需要人工判断，引擎不自动套用；例词逐个标注。",
      "apply": {
        "type": "manualKeepTone",
        "marker": "!",
        "note": "数据中在音节后加 ! 表示该音节的声调不省写；引擎不自动判断"
      },
      "examples": [
        [
          "问",
          "wèn!",
          "提供点位参照"
        ],
        [
          "地道",
          "dì!dào!",
          "与轻声的“地道”区分"
        ],
        [
          "再",
          "zài!",
          "与省写的“在”区分"
        ]
      ]
    },
    {
      "id": "11.1",
      "title": "的、么、你、他、她、它简写",
      "cat": "简写",
      "page": 9,
      "text": "“的、么、你、他、她、它”简写。",
      "note": "d、m、n、t 表示字母时加字母号；不产生混淆时字母号可以省略。",
      "apply": {
        "type": "contraction",
        "byChar": true,
        "useForms": true,
        "note": "按汉字判断（同音的“得”等不简写），需要汉字与音节对齐的输入"
      },
      "forms": [
