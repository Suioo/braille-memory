    "wan": "uan",
    "wang": "uang",
    "wen": "uen",
    "weng": "ueng",
    "yu": "ü",
    "yue": "üe",
    "yuan": "üan",
    "yun": "ün"
  },
  "afterInitial": {
    "iu": "iou",
    "ui": "uei",
    "un": "uen"
  },
  "uAsU_umlaut": {
    "initials": [
      "j",
      "q",
      "x"
    ],
    "map": {
      "u": "ü",
      "ue": "üe",
      "uan": "üan",
      "un": "ün"
    },
    "note": "j、q、x 后的 u 实为 ü（先于 afterInitial 的 un→uen 处理）"
  },
  "vAsUmlaut": {
    "v": "ü",
    "note": "输入法习惯：v 视同 ü（如 lv、nve）"
  },
  "finalAliases": {
    "o": "o、e",
    "e": "o、e",
    "ong": "ong、ueng",
    "ueng": "ong、ueng"
  },
  "initialAliases": {
    "g": "g、j",
    "j": "g、j",
    "k": "k、q",
    "q": "k、q",
    "h": "h、x",
