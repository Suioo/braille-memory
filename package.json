{
  "name": "braille-memory",
  "productName": "盲文记忆",
  "version": "2.12.0",
  "description": "汉语现行盲文（GF 0019—2018）点位记忆练习，支持 Windows 与 Android，离线使用",
  "keywords": [
    "braille",
    "chinese-braille",
    "盲文",
    "现行盲文",
    "GF 0019-2018",
    "pinyin",
    "electron",
    "capacitor",
    "education",
    "accessibility"
  ],
  "license": "GPL-3.0-or-later",
  "author": "Gan",
  "homepage": "https://github.com/Suioo/braille-memory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Suioo/braille-memory.git"
  },
  "bugs": {
    "url": "https://github.com/Suioo/braille-memory/issues"
  },
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "pack": "electron-builder --win dir",
    "icon": "electron tools/make-icon.js",
    "www": "node tools/build-www.js",
    "android:icons": "electron tools/make-android-icons.js",
    "android:sync": "node tools/build-www.js && cap sync android",
    "android:build": "node tools/android-build.js",
    "android:release": "node tools/android-build.js --release",
    "vendor": "node tools/vendor.js"
  },
  "build": {
    "appId": "local.braille-memory",
    "productName": "盲文记忆",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data"
      },
      {
        "from": "private",
        "to": ".",
        "filter": [
          "contact.json"
        ]
      }
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "npmRebuild": false
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/core": "8.5.2",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "pinyin-pro": "3.29.5"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2"
  }
}
